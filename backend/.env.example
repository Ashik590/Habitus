APP_NAME=Language Practice API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://username:password@host:5432/database

JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Leave FRONTEND_DIST_DIR unset during Vite development.
# FRONTEND_DIST_DIR=/app/frontend-dist
PROFILE_PICTURE_STORAGE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-pictures
